<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Registros imutaveis e controllers JavaFX expoem referencias por desenho (listas ja imutaveis, nos da cena). -->
    <Match><Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/></Match>
    <!-- Campos @FXML sao injetados por reflexao. -->
    <Match><Bug pattern="UWF_UNWRITTEN_FIELD,NP_UNWRITTEN_FIELD,UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/></Match>
    <!-- Construtores que validam e lancam excecao amigavel. -->
    <Match><Bug pattern="CT_CONSTRUCTOR_THROW"/></Match>
    <!-- Random com semente fixa e criado de proposito a cada chamada: e o que torna os experimentos reprodutiveis. -->
    <Match><Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/></Match>
    <!-- Path.getFileName() so e nulo para a raiz do disco, que nunca e um arquivo de dados ou relatorio aqui. -->
    <Match><Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/></Match>
    <!-- Rotulos constantes (meses, nomes das variaveis do ML) lidos por indice em todo o codigo; nunca sao alterados. -->
    <Match><Class name="br.unip.aps.analysis.Estatisticas"/><Field name="MESES"/><Bug pattern="MS_MUTABLE_ARRAY"/></Match>
    <Match><Class name="br.unip.aps.ml.BaseMensal"/><Field name="VARIAVEIS"/><Bug pattern="MS_MUTABLE_ARRAY"/></Match>
    <!-- O leitor envolve a entrada do ZIP, que e fechada pelo try-with-resources externo. -->
    <Match><Class name="br.unip.aps.io.DownloaderInpe"/><Method name="baixarTodosSatelites"/><Bug pattern="OS_OPEN_STREAM"/></Match>
</FindBugsFilter>
