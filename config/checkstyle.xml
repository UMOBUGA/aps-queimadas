<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Convencoes do projeto: sem tabs, sem imports inuteis, sem comentarios de linha no codigo (so Javadoc curto), sem APIs de ordenacao prontas. -->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>
    <module name="FileTabCharacter"/>
    <module name="LineLength">
        <property name="max" value="200"/>
        <property name="ignorePattern" value="^import |https?://|^\s*\{?&quot;|append\(&quot;"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Espaco em branco no fim da linha."/>
    </module>
    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport"/>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="FallThrough"/>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignorada|ignorado|expected"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="ConstantName"/>
        <module name="RegexpSinglelineJava">
            <property name="format" value="^\s*//"/>
            <property name="message" value="Sem comentarios de linha: use nomes claros ou Javadoc curto."/>
            <property name="ignoreComments" value="false"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="(Collections|Arrays)\.sort\(|\.stream\(\)\.sorted\(|new (TreeMap|TreeSet|PriorityQueue)\b"/>
            <property name="message" value="Ordenacao pronta da biblioteca e proibida em src/main: use sorting.Ordenacoes.ordenar."/>
            <property name="ignoreComments" value="true"/>
        </module>
    </module>
    <module name="SuppressionSingleFilter">
        <property name="checks" value="RegexpSinglelineJava"/>
        <property name="files" value="src.(test|jmh)."/>
        <property name="message" value="Ordenacao pronta"/>
    </module>
</module>
