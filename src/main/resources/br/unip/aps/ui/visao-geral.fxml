<?xml version="1.0" encoding="UTF-8"?>

<?import br.unip.aps.ui.componentes.ChartCard?>
<?import br.unip.aps.ui.componentes.GradeResponsiva?>
<?import br.unip.aps.ui.componentes.KpiCard?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.unip.aps.ui.VisaoGeralController" fitToWidth="true" styleClass="pagina-scroll">
    <VBox styleClass="page">
        <GradeResponsiva larguraMinima="250" maxColunas="4" gap="16">
            <KpiCard fx:id="kTotal" titulo="Total de focos" icone="mdi2f-fire"/>
            <KpiCard fx:id="kAnoAnterior" titulo="Focos no ano anterior" icone="mdi2c-calendar-outline"/>
            <KpiCard fx:id="kAnoRecente" titulo="Focos no ano recente" icone="mdi2c-calendar-outline"/>
            <KpiCard fx:id="kVariacao" titulo="Variação anual" icone="mdi2t-trending-up"/>
            <KpiCard fx:id="kMunicipios" titulo="Municípios afetados" icone="mdi2m-map-marker-outline"/>
            <KpiCard fx:id="kPico" titulo="Mês de pico" icone="mdi2c-calendar-month-outline"/>
            <KpiCard fx:id="kLider" titulo="Município líder" icone="mdi2t-trophy-outline"/>
            <KpiCard fx:id="kBioma" titulo="Bioma predominante" icone="mdi2t-tree-outline"/>
        </GradeResponsiva>
        <GradeResponsiva larguraMinima="540" maxColunas="2" gap="16">
            <ChartCard fx:id="cMensal" titulo="Focos por mês"
                       subtitulo="Comparação mês a mês entre os anos da base" prefHeight="380"/>
            <ChartCard fx:id="cBiomas" titulo="Focos por bioma"
                       subtitulo="Participação de cada bioma do IBGE no total filtrado" prefHeight="380"/>
            <ChartCard fx:id="cMunicipios" titulo="Top 10 municípios"
                       subtitulo="Municípios com mais focos no período filtrado" prefHeight="420"/>
            <ChartCard fx:id="cHoras" titulo="Focos por hora local (UTC−3)"
                       subtitulo="O satélite de referência (AQUA) passa sobre SP no início da tarde: por isso as detecções se concentram entre 13h e 15h"
                       prefHeight="420"/>
        </GradeResponsiva>
        <ChartCard fx:id="cCalendario" titulo="Calendário de focos por dia"
                   subtitulo="Cada quadrado é um dia; a cor indica a quantidade de focos detectados"/>
    </VBox>
</ScrollPane>
