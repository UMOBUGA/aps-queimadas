<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.unip.aps.ui.VisaoGeralController" fitToWidth="true" styleClass="aba">
    <VBox spacing="12">
        <padding><Insets top="12" right="14" bottom="14" left="14"/></padding>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="painel-filtros">
            <Label text="Bioma:"/>
            <ComboBox fx:id="cbBioma" prefWidth="170"/>
            <Label text="Município contém:"/>
            <TextField fx:id="tfMunicipio" promptText="ex.: são carlos" prefWidth="200" onAction="#aplicar"/>
            <Button text="Aplicar" onAction="#aplicar" styleClass="botao-primario"/>
            <Button text="Limpar" onAction="#limpar"/>
            <Label fx:id="lblFiltro" styleClass="texto-suave"/>
        </HBox>
        <FlowPane fx:id="kpis" hgap="10" vgap="10"/>
        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <LineChart fx:id="graficoMensal" title="Focos por mês" GridPane.columnIndex="0" GridPane.rowIndex="0"
                       prefHeight="330" createSymbols="true" animated="false">
                <xAxis><CategoryAxis label="Mês"/></xAxis>
                <yAxis><NumberAxis label="Focos"/></yAxis>
            </LineChart>
            <PieChart fx:id="graficoBiomas" title="Focos por bioma" GridPane.columnIndex="1" GridPane.rowIndex="0"
                      prefHeight="330" animated="false" labelsVisible="true"/>
            <BarChart fx:id="graficoMunicipios" title="Top 10 municípios" GridPane.columnIndex="0" GridPane.rowIndex="1"
                      prefHeight="360" animated="false" legendVisible="false">
                <xAxis><NumberAxis label="Focos"/></xAxis>
                <yAxis><CategoryAxis/></yAxis>
            </BarChart>
            <BarChart fx:id="graficoHoras" title="Focos por hora local da detecção (UTC−3)" GridPane.columnIndex="1"
                      GridPane.rowIndex="1" prefHeight="360" animated="false" legendVisible="false">
                <xAxis><CategoryAxis label="Hora"/></xAxis>
                <yAxis><NumberAxis label="Focos"/></yAxis>
            </BarChart>
        </GridPane>
        <Label wrapText="true" styleClass="texto-suave"
               text="Base: satélite de referência (AQUA, tarde). Horários do INPE estão em GMT; o gráfico de horas converte para o horário de Brasília. Em 2024 o estado de São Paulo viveu uma crise de incêndios em agosto — observe o pico no gráfico mensal."/>
    </VBox>
</ScrollPane>
