<?xml version="1.0" encoding="UTF-8"?>

<?import br.unip.aps.ui.componentes.ChartCard?>
<?import br.unip.aps.ui.componentes.GradeResponsiva?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.unip.aps.ui.VisaoGeralController" fitToWidth="true" styleClass="pagina-scroll">
    <VBox styleClass="page">
        <VBox styleClass="manchete">
            <Label fx:id="mLinha" styleClass="manchete-linha"/>
            <HBox fx:id="mNumeroLinha" spacing="16" alignment="BOTTOM_LEFT">
                <Label fx:id="mNumero" styleClass="manchete-numero" text="—"/>
                <Label fx:id="mUnidade" styleClass="manchete-unidade" text="focos de incêndio"/>
            </HBox>
            <TextFlow fx:id="mApoio" maxWidth="820"/>
            <Label fx:id="mMetodo" styleClass="nota-metodo" wrapText="true" maxWidth="820"
                   text="Contagem do satélite de referência do INPE (AQUA, passagem no início da tarde): é o mesmo sensor todos os anos, o que torna os anos comparáveis, mas um foco curto ou noturno pode não ser registrado. Por isso os números indicam a tendência, não o total de queimadas."/>
        </VBox>
        <FlowPane fx:id="destaques" styleClass="destaques" vgap="18"/>
        <ChartCard fx:id="cMensal" titulo="A temporada, mês a mês"
                   subtitulo="Focos detectados por mês em cada ano da base" prefHeight="440"/>
        <GradeResponsiva larguraMinima="520" maxColunas="2" gap="36">
            <ChartCard fx:id="cMunicipios" titulo="Onde queima"
                       subtitulo="Os 10 municípios com mais focos no período filtrado" prefHeight="440"/>
            <ChartCard fx:id="cBiomas" titulo="Em que bioma"
                       subtitulo="Participação de cada bioma do IBGE no total filtrado" prefHeight="440"/>
        </GradeResponsiva>
        <ChartCard fx:id="cBiomasMes" titulo="Cada bioma, mês a mês"
                   subtitulo="Pequenos múltiplos com o mesmo eixo vertical: dá para comparar a altura dos picos entre os biomas" prefHeight="340"/>
        <ChartCard fx:id="cComparar" titulo="Comparar dois períodos"
                   subtitulo="Escolha dois meses da base; os números usam a base inteira, sem os filtros acima"/>
        <ChartCard fx:id="cHistorico" titulo="Seis temporadas, de 2019 a 2024"
                   subtitulo="Focos por mês em São Paulo, mesmo satélite de referência; o histórico não passa pelos filtros acima"/>
        <ChartCard fx:id="cBrasil" titulo="São Paulo no Brasil"
                   subtitulo="Focos por estado no ano escolhido (satélite de referência), do maior para o menor, ordenados pelo Merge Sort do projeto"/>
        <ChartCard fx:id="cCalendario" titulo="Dia a dia"
                   subtitulo="Cada quadrado é um dia; quanto mais quente a cor, mais focos detectados"/>
        <ChartCard fx:id="cHoras" titulo="A que horas o satélite vê"
                   subtitulo="Hora local (UTC−3). O satélite de referência (AQUA) passa sobre SP no início da tarde, por isso as detecções se concentram entre 13h e 15h"
                   prefHeight="330"/>
    </VBox>
</ScrollPane>
