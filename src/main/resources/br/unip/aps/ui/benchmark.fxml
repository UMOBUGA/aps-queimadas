<?xml version="1.0" encoding="UTF-8"?>

<?import br.unip.aps.ui.componentes.ChartCard?>
<?import br.unip.aps.ui.componentes.GradeResponsiva?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.unip.aps.ui.BenchmarkController" fitToWidth="true">
    <VBox styleClass="page">
        <VBox styleClass="panel-card" spacing="12">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Configuração da bateria" styleClass="card-title"/>
                    <Label text="Cada caso: aquecimentos descartados (JIT) + repetições medidas (média ± desvio). Todos os algoritmos recebem exatamente a mesma entrada. Usa a base completa (sem o filtro global)."
                           styleClass="card-subtitle" wrapText="true"/>
                </VBox>
                <Button fx:id="btnSalvos" text="Abrir resultados salvos" onAction="#abrirSalvos" styleClass="btn-ghost"/>
                <Button fx:id="btnRapida" text="Configuração rápida" onAction="#configRapida" styleClass="btn-secondary"/>
                <Button fx:id="btnExecutar" text="Executar benchmark" onAction="#executar" styleClass="btn-primary"/>
            </HBox>
            <GridPane hgap="32" vgap="10">
                <Label text="Algoritmos" styleClass="section-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <FlowPane fx:id="fpAlgoritmos" hgap="6" vgap="6" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.hgrow="ALWAYS"/>
                <Label text="Critérios" styleClass="section-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <FlowPane fx:id="fpCriterios" hgap="6" vgap="6" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Cenários" styleClass="section-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <FlowPane fx:id="fpCenarios" hgap="6" vgap="6" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Execução" styleClass="section-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="3" GridPane.columnIndex="1">
                    <Label text="Tamanhos (n)" styleClass="field-label"/>
                    <TextField fx:id="tfTamanhos" text="100, 1000, 5000, 10000, todos" prefWidth="220" promptText="use todos para a base inteira"/>
                    <Label text="Aquecimentos" styleClass="field-label"/>
                    <Spinner fx:id="spAquecimentos" prefWidth="84"/>
                    <Label text="Repetições" styleClass="field-label"/>
                    <Spinner fx:id="spRepeticoes" prefWidth="84"/>
                </HBox>
            </GridPane>
        </VBox>
        <Label fx:id="lblOrigem" styleClass="nota-origem" wrapText="true" managed="false" visible="false" maxWidth="Infinity"/>

        <FlowPane fx:id="barraVisao" hgap="10" vgap="8" alignment="CENTER_LEFT">
            <HBox fx:id="segCriterio" styleClass="segmented"/>
            <HBox fx:id="segCenario" styleClass="segmented"/>
            <HBox fx:id="segMetrica" styleClass="segmented"/>
            <HBox fx:id="segEscala" styleClass="segmented"/>
        </FlowPane>

        <GradeResponsiva larguraMinima="520" maxColunas="2" gap="32">
            <ChartCard fx:id="cQuadraticos" titulo="Algoritmos O(n²)" subtitulo="Bubble, Selection e Insertion" prefHeight="420"/>
            <ChartCard fx:id="cLogLineares" titulo="Algoritmos O(n log n) e lineares" subtitulo="Shell, Merge, Quick, Quick 3-Way, Heap, Tim e Radix" prefHeight="420"/>
        </GradeResponsiva>

        <GradeResponsiva larguraMinima="520" maxColunas="2" gap="32">
            <ChartCard fx:id="cVencedores" titulo="Vencedores por critério e cenário" subtitulo="Menor tempo médio no maior n medido; ★ = vencedor" prefHeight="360"/>
            <ChartCard fx:id="cComplexidade" titulo="Complexidade empírica" subtitulo="Expoente k da regressão log-log (custo ≈ c·nᵏ): ≈2 para O(n²), ≈1,0–1,2 para O(n log n)" prefHeight="360"/>
        </GradeResponsiva>

        <TitledPane text="Todas as medições" expanded="false" styleClass="titled-plano">
            <TableView fx:id="tabela" prefHeight="420"/>
        </TitledPane>
    </VBox>
</ScrollPane>
