<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.unip.aps.ui.MapaController" fx:id="moldura" styleClass="mapa-palco">
    <WebView fx:id="webView"/>
    <VBox styleClass="mapa-titulo" pickOnBounds="false" StackPane.alignment="BOTTOM_LEFT" maxWidth="-Infinity" maxHeight="-Infinity">
        <StackPane.margin>
            <Insets bottom="44" left="20"/>
        </StackPane.margin>
        <Label fx:id="lblContagem" styleClass="mapa-titulo-numero" text="—"/>
        <Label fx:id="lblContagemTexto" styleClass="mapa-titulo-texto" text="focos no mapa"/>
    </VBox>
    <HBox styleClass="mapa-controles" spacing="10" alignment="CENTER_LEFT" maxWidth="-Infinity" maxHeight="-Infinity" StackPane.alignment="TOP_RIGHT">
        <StackPane.margin>
            <Insets top="18" right="64"/>
        </StackPane.margin>
        <HBox fx:id="segModo" styleClass="segmented">
            <ToggleButton fx:id="tgPontos" text="Pontos" selected="true"/>
            <ToggleButton fx:id="tgCluster" text="Agrupado"/>
            <ToggleButton fx:id="tgCalor" text="Calor"/>
            <ToggleButton fx:id="tgMunicipios" text="Municípios"/>
        </HBox>
        <HBox fx:id="boxCoro" spacing="8" alignment="CENTER_LEFT" managed="false" visible="false">
            <HBox fx:id="segMedida" styleClass="segmented">
                <ToggleButton fx:id="tgDensidade" text="Por 1.000 km²" selected="true"/>
                <ToggleButton fx:id="tgContagem" text="Contagem"/>
            </HBox>
            <HBox fx:id="segClasses" styleClass="segmented">
                <ToggleButton fx:id="tgJenks" text="Jenks" selected="true"/>
                <ToggleButton fx:id="tgQuantis" text="Quantis"/>
            </HBox>
        </HBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Cor por" styleClass="field-label"/>
            <HBox fx:id="segCor" styleClass="segmented">
                <ToggleButton fx:id="tgBioma" text="Bioma" selected="true"/>
                <ToggleButton fx:id="tgAno" text="Ano"/>
            </HBox>
        </HBox>
        <ToggleButton fx:id="tgHotspots" text="Hotspots do ML" styleClass="chip-toggle" disable="true"/>
    </HBox>
</StackPane>
