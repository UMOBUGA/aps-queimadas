<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.web.WebView?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.unip.aps.ui.MapaController" styleClass="page">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Modo" styleClass="field-label"/>
        <HBox fx:id="segModo" styleClass="segmented">
            <ToggleButton fx:id="tgPontos" text="Pontos" selected="true"/>
            <ToggleButton fx:id="tgCluster" text="Agrupado"/>
            <ToggleButton fx:id="tgCalor" text="Calor"/>
        </HBox>
        <Label text="Cor por" styleClass="field-label"/>
        <HBox fx:id="segCor" styleClass="segmented">
            <ToggleButton fx:id="tgBioma" text="Bioma" selected="true"/>
            <ToggleButton fx:id="tgAno" text="Ano"/>
        </HBox>
        <ToggleButton fx:id="tgHotspots" text="Hotspots do ML" styleClass="chip-toggle" disable="true"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblContagem" styleClass="chip"/>
    </HBox>
    <StackPane fx:id="moldura" styleClass="chart-card" VBox.vgrow="ALWAYS">
        <WebView fx:id="webView"/>
    </StackPane>
</VBox>
