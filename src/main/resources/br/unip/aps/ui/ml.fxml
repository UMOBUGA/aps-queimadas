<?xml version="1.0" encoding="UTF-8"?>

<?import br.unip.aps.ui.componentes.ChartCard?>
<?import br.unip.aps.ui.componentes.GradeResponsiva?>
<?import br.unip.aps.ui.componentes.KpiCard?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.TextFlow?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.unip.aps.ui.MlController" fitToWidth="true">
    <VBox styleClass="page">
        <VBox styleClass="panel-card" spacing="10">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Validação temporal" styleClass="card-title"/>
                    <Label fx:id="lblPreparo" text="Os focos são ordenados por município → data (Merge Sort) e agregados por município/mês. Treino em um ano, teste no seguinte. Usa a base completa."
                           styleClass="card-subtitle" wrapText="true"/>
                </VBox>
                <Button fx:id="btnMapa" text="Ver hotspots no mapa" onAction="#verNoMapa" styleClass="btn-secondary" disable="true"/>
                <Button fx:id="btnTreinar" text="Treinar e avaliar" onAction="#executar" styleClass="btn-primary"/>
            </HBox>
            <FlowPane hgap="14" vgap="8">
                <HBox spacing="6" alignment="CENTER_LEFT"><Label text="Treino" styleClass="field-label"/><ComboBox fx:id="cbTreino" prefWidth="90"/></HBox>
                <HBox spacing="6" alignment="CENTER_LEFT"><Label text="Teste" styleClass="field-label"/><ComboBox fx:id="cbTeste" prefWidth="90"/></HBox>
                <HBox spacing="6" alignment="CENTER_LEFT"><Label text="Árvores (RF)" styleClass="field-label"/><Spinner fx:id="spArvores" prefWidth="96"/></HBox>
                <HBox spacing="6" alignment="CENTER_LEFT"><Label text="K-Means k" styleClass="field-label"/><Spinner fx:id="spK" prefWidth="80"/></HBox>
                <HBox spacing="6" alignment="CENTER_LEFT"><Label text="DBSCAN eps (km)" styleClass="field-label"/><Spinner fx:id="spEps" prefWidth="86"/></HBox>
                <HBox spacing="6" alignment="CENTER_LEFT"><Label text="minPts" styleClass="field-label"/><Spinner fx:id="spMinPts" prefWidth="86"/></HBox>
            </FlowPane>
        </VBox>

        <GradeResponsiva larguraMinima="170" maxColunas="5" gap="24">
            <KpiCard fx:id="kMae" titulo="MAE · Random Forest" icone="mdi2t-target"/>
            <KpiCard fx:id="kRmse" titulo="RMSE" icone="mdi2s-sigma"/>
            <KpiCard fx:id="kR2" titulo="R²" icone="mdi2c-chart-scatter-plot"/>
            <KpiCard fx:id="kAcuracia" titulo="Acurácia" icone="mdi2c-check-circle-outline"/>
            <KpiCard fx:id="kF1" titulo="F1 macro" icone="mdi2g-grid"/>
        </GradeResponsiva>

        <GradeResponsiva larguraMinima="540" maxColunas="2" gap="32">
            <ChartCard fx:id="cPrevisao" titulo="Focos no estado por mês: real × previsto" subtitulo="Soma das previsões por município no ano de teste" prefHeight="400"/>
            <ChartCard fx:id="cMatriz" titulo="Nível de atividade: matriz de confusão" subtitulo="Linhas = classe real; cor = % da classe real prevista em cada coluna" prefHeight="400"/>
            <ChartCard fx:id="cImportancia" titulo="Importância das variáveis" subtitulo="Redução de impureza média nas árvores (regressão)" prefHeight="400"/>
            <ChartCard fx:id="cHotspots" titulo="Hotspots geográficos" subtitulo="Grupos de focos encontrados pela clusterização" prefHeight="400"/>
        </GradeResponsiva>

        <GradeResponsiva larguraMinima="540" maxColunas="2" gap="32">
            <ChartCard fx:id="cCotovelo" titulo="Método do cotovelo (K-Means)" subtitulo="Distorção média (km²) × k: o 'cotovelo' sugere um k adequado" prefHeight="300"/>
            <VBox styleClass="panel-card" spacing="8">
                <Label text="Sobre os modelos" styleClass="card-title"/>
                <TextFlow fx:id="textoSobre" styleClass="texto-sobre"/>
            </VBox>
        </GradeResponsiva>
    </VBox>
</ScrollPane>
