<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ToggleSwitch?>
<?import br.unip.aps.ui.componentes.GradeResponsiva?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.unip.aps.ui.ConfiguracoesController" fitToWidth="true">
    <VBox styleClass="page">
        <GradeResponsiva larguraMinima="480" maxColunas="2" gap="16">
            <VBox styleClass="panel-card" spacing="4">
                <Label text="Aparência" styleClass="card-title"/>
                <Label text="Preferências salvas automaticamente para as próximas execuções." styleClass="card-subtitle"/>
                <HBox styleClass="config-linha">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Tema" styleClass="t-h3"/>
                        <Label text="Claro para impressão e projetores; escuro para ambientes com pouca luz." styleClass="t-small" wrapText="true"/>
                    </VBox>
                    <HBox styleClass="segmented">
                        <ToggleButton fx:id="tgClaro" text="Claro"/>
                        <ToggleButton fx:id="tgEscuro" text="Escuro"/>
                    </HBox>
                </HBox>
                <HBox styleClass="config-linha">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Animações" styleClass="t-h3"/>
                        <Label text="Transições de 200–300 ms em telas, gráficos e notificações." styleClass="t-small" wrapText="true"/>
                    </VBox>
                    <ToggleSwitch fx:id="swAnimacoes"/>
                </HBox>
                <HBox styleClass="config-linha">
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Menu lateral recolhido" styleClass="t-h3"/>
                        <Label text="Mostra apenas os ícones (mais espaço para os gráficos)." styleClass="t-small" wrapText="true"/>
                    </VBox>
                    <ToggleSwitch fx:id="swSidebar"/>
                </HBox>
                <HBox spacing="8" styleClass="acoes-rodape">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnRestaurar" text="Restaurar padrões" onAction="#restaurar" styleClass="btn-secondary"/>
                </HBox>
            </VBox>

            <VBox styleClass="panel-card" spacing="10">
                <Label text="Atalhos de teclado" styleClass="card-title"/>
                <Label text="Navegação completa pelo teclado; Tab percorre os controles com foco visível." styleClass="card-subtitle"/>
                <GridPane fx:id="gridAtalhos" hgap="16" vgap="10"/>
            </VBox>

            <VBox styleClass="panel-card" spacing="10">
                <Label text="Dados e relatórios" styleClass="card-title"/>
                <Label text="Definidos em application.properties (sobrescreva criando aps.properties na pasta de execução)." styleClass="card-subtitle" wrapText="true"/>
                <GridPane fx:id="gridDados" hgap="16" vgap="10"/>
            </VBox>
        </GradeResponsiva>
    </VBox>
</ScrollPane>
